# Generated by rea-hardware. `make all` regenerates every derived artifact and runs every gate.
PY ?= python3
RHW ?= rea-hw

.PHONY: all gates test case fab renders video readme clean help

all: case fab renders video test readme  ## Rebuild everything and verify

help:
	@grep -E '^[a-z-]+:.*##' $(MAKEFILE_LIST) | sed 's/:.*##/\t/'

case:  ## Regenerate enclosure STLs from case/generate_case.py
	$(PY) case/generate_case.py

gates:  ## Run all design gates and print the report
	$(RHW) gates .

test:  ## Run the generated pytest suite (one test per gate)
	$(PY) -m pytest -q tests

fab:  ## Gerbers, drill, BOM + CPL (fab format), STEP, schematic PDF -> fab/
	$(RHW) fab .

renders:  ## Stills and reference-photo comparisons -> docs/
	$(RHW) render .

video:  ## 3D build video from rea/spec.yaml assembly order -> docs/build-video.mp4
	$(RHW) video .

readme:  ## Regenerate README.md from the latest reports
	$(RHW) readme .

clean:
	rm -rf build fab/gerbers fab/*.zip
